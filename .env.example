# Copy to .env for local development. Never commit .env.
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret-before-deployment
# Plain HTTP local only; use 1 behind public HTTPS (including HTTPS Preview).
COOKIE_SECURE=0
# Leave blank for instance/arthasutra.sqlite3; use a real SQLAlchemy URL only when configured.
DATABASE_URL=libsql://artha-sutra-niranjan-00.aws-ap-south-1.turso.io

# Default 10 MiB maximum for privately stored invoice documents.
MAX_CONTENT_LENGTH=10485760
# Local development uses 5000; the Manus Preview/container supplies PORT=3000.
PORT=5000
# Optional persistent mount path for private uploads (requires a persistent host volume).
# UPLOAD_FOLDER=
